# Standard .gcloudignore for Node.js
# Dist and modules
node_modules/
dist/

# Git
.git/
.gitignore

# Env and secrets
.env
*.pem

# Local artifacts
scratch/
scripts/

# Explicitly KEEP these (removing from ignore list if they were there)
!Dockerfile
!package.json
!package-lock.json
!prisma/
!src/
!tsconfig.json
!prisma.config.ts
